{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dancecalendar",
  "account_id": "b1960e03e4c5698895fb3dca8897c037",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    "PUBLIC_URL": "https://dancecalendar.dancecalendar.workers.dev",
    // Geocoders for new Venues (src/geocode.ts); "" switches one off.
    "PHOTON_URL": "https://photon.komoot.io",
    "NOMINATIM_URL": "https://nominatim.openstreetmap.org"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dancecalendar",
      "database_id": "6ff5739a-a0d1-4bad-98dd-93ed50555207",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FLYERS",
      "bucket_name": "dancecalendar-flyers",
      "jurisdiction": "eu"
    }
  ],
  // Hourly: held Flyers of unfinished applications, old Tip data. Daily: Series generate their next Events,
  // and the Admin's email at 21:00 German time, which is 19:00 or 20:00 UTC (src/index.tsx).
  "triggers": { "crons": ["17 * * * *", "30 2 * * *", "0 19,20 * * *"] },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "dancecalendar-jobs" }],
    "consumers": [{ "queue": "dancecalendar-jobs", "max_batch_size": 1, "max_retries": 2 }]
  }
}
