# Sample Flyers may contain phone numbers and names
.scratch/*/assets/flyers/

# Extraction eval raw outputs echo Flyer text
.scratch/*/eval/results/*/

# Worker secrets for local dev (Wrangler)
.dev.vars

# Meta setup wizard run log
.scratch/*/wizards/meta-setup-log.md

# Node and Wrangler
node_modules/
.wrangler/
__pycache__/

# Database exports hold Organizers' WhatsApp numbers.
backup-*.sql

# Design-review screenshots show real sample Flyers (names, faces)
.scratch/*/prototypes/design-review/

# Impeccable: review screenshots show real sample Flyers; local config and caches stay on this machine
.impeccable/review/
.impeccable/config.local.json
.impeccable/hook.cache.json
